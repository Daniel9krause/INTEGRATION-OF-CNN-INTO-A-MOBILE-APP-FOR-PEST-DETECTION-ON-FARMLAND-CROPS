<ResultScreen>:
    ScrollView:
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: dp(14)
            spacing: dp(10)

            Image:
                source: root.image_path
                size_hint_y: None
                height: dp(240)
                allow_stretch: True

            Label:
                text: root.label_text
                bold: True
                font_size: "20sp"
                color: root.confidence_color
                size_hint_y: None
                height: self.texture_size[1]
                halign: "left"
                valign: "top"
                text_size: self.width, None

            # Confidence is hidden entirely when no diagnosis was made.
            # A "0.0%" bar under "No plant detected" reads as a confident
            # all-clear to anyone skimming the screen.
            Label:
                text: root.confidence_text
                font_size: "14sp"
                color: root.confidence_color
                size_hint_y: None
                height: dp(22) if root.show_confidence else 0
                opacity: 1 if root.show_confidence else 0

            ProgressBar:
                max: 100
                value: root.confidence_value
                size_hint_y: None
                height: dp(14) if root.show_confidence else 0
                opacity: 1 if root.show_confidence else 0

            Label:
                text: "Organism Group: [b]" + root.group_text + "[/b]"
                markup: True
                size_hint_y: None
                height: self.texture_size[1]
                halign: "left"
                valign: "top"
                text_size: self.width, None

            Label:
                text: root.description_text
                size_hint_y: None
                height: self.texture_size[1]
                halign: "left"
                valign: "top"
                text_size: self.width, None
                font_size: "13sp"

            # For a refusal this box carries "how to retake the photo",
            # never a treatment recommendation - see utils/result_presentation.
            Label:
                text: ("Advisory:\n" + root.advisory_text) if root.show_advisory else ""
                color: 0, 0, 0, 1
                halign: "left"
                valign: "top"
                text_size: self.width - dp(16), None
                padding: dp(8), dp(8)
                size_hint_y: None
                height: (self.texture_size[1] + dp(16)) if root.show_advisory else 0
                opacity: 1 if root.show_advisory else 0
                canvas.before:
                    Color:
                        rgba: (0.9, 0.97, 0.9, 1) if root.show_advisory else (0, 0, 0, 0)
                    Rectangle:
                        pos: self.pos
                        size: self.size

            Button:
                text: "This doesn't look right — flag as new/unknown organism"
                size_hint_y: None
                height: dp(44) if root.show_flag_button else 0
                opacity: 1 if root.show_flag_button else 0
                disabled: not root.show_flag_button
                on_release: root.flag_as_new_organism()

            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)

                Button:
                    text: "Scan Another"
                    on_release: root.go_home()

                Button:
                    text: "View History"
                    on_release: root.go_to_history()
