.buildozer/
bin/
storage/
collected_data/
__pycache__/
*.pyc
*.apk
.venv/
venv/

# Raw training images: large, sourced from public datasets already linked
# in data/dataset/README.md — no need to version them. The trained
# model/pest_model.tflite (the actual deliverable) IS committed.
data/dataset/*
!data/dataset/README.md

.claude/

# Generated by the evaluation/test harnesses — all regenerable, none of it
# is input to the build:
#   eval_negatives/  `python train/evaluate_rejection.py --fetch` re-downloads it
#   _eval_scratch/   synthetic junk frames built fresh on each run
#   tests/_tmp/      test fixtures copied out of data/dataset
train/eval_negatives/
train/_eval_scratch/
tests/_tmp/
